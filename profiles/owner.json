{
  "schema": 1,
  "config": {
    "project_doc_max_bytes": 65536,
    "model": "gpt-6.1-sol",
    "model_reasoning_effort": "high",
    "service_tier": "default",
    "desktop": {
      "followUpQueueMode": "steer",
      "conversationDetailMode": "STEPS_COMMANDS",
      "projectlessWorkspaceRoot": "${DOCUMENTS}/Codex",
      "localeOverride": "ru-RU",
      "code-review-sidebar-layout": "compact",
      "git-worktree-root": "${DOCUMENTS}/Codex/worktrees",
      "worktree-upstream-refresh-mode": "best-effort",
      "worktree-keep-count": 5,
      "dictationDictionary": [],
      "microphoneInputDeviceId": "communications",
      "keepRemoteControlAwakeWhilePluggedIn": true,
      "external-agent-import-sync-item-types": "all",
      "external-agent-import-sync-enabled": true,
      "agent-usage-reset-enabled": true,
      "open-in-target-preferences": {
        "global": "fileManager"
      }
    },
    "windows": {
      "sandbox": "elevated"
    },
    "skills": {
      "config": [
        {
          "path": "${USERPROFILE}/.agents/skills/canvas/SKILL.md",
          "enabled": false
        },
        {
          "path": "${USERPROFILE}/.agents/skills/sdk/SKILL.md",
          "enabled": false
        },
        {
          "path": "${USERPROFILE}/.agents/skills/update-cli-config/SKILL.md",
          "enabled": false
        },
        {
          "path": "${USERPROFILE}/.agents/skills/update-cursor-settings/SKILL.md",
          "enabled": false
        },
        {
          "path": "${USERPROFILE}/.agents/skills/autoglm-browser-agent/SKILL.md",
          "enabled": false
        },
        {
          "path": "${USERPROFILE}/.agents/skills/mansur-frontend-mentor/SKILL.md",
          "enabled": false
        }
      ]
    },
    "features": {
      "memories": true,
      "multi_agent": true
    },
    "memories": {
      "generate_memories": true,
      "use_memories": true
    },
    "tui": {
      "screen_reader_detection_done": true
    }
  },
